__pycache__/
*.pyc
.claude/settings.local.json
.yfinance-cache/

# Rendered workbooks are a deliverable, not a source artifact: 400 files and ~25 MB,
# regenerated by --surface / --summary / --validation / --skew in a couple of minutes. The .npz
# cubes they render *are* tracked -- those are the measurement, and the claim that
# this repo carries a faithful record rests on them.
workspaces/*/01_surface_xlsx/
workspaces/*/02_summary_xlsx/
workspaces/*/03_validation_xlsx/
workspaces/*/04_skew_xlsx/
